load("//bazel:rust_crate.bzl", "workspace_rust_library")

workspace_rust_library(
    name = "cda_plugin_runtime_update",
    srcs = glob(["src/**/*.rs"]),
    crate_deps = [
        "bytes",
        "schemars",
        "serde",
        "serde_json",
        "sha2",
        "thiserror",
        "tokio",
        "tracing",
        "uuid",
    ],
    crate_name = "cda_plugin_runtime_update",
    crate_root = "src/lib.rs",
    proc_macro_crate_deps = ["async-trait"],
    visibility = [
        "//cda-comm-uds:__pkg__",
        "//cda-main:__pkg__",
        "//cda-sovd:__pkg__",
    ],
    deps = [
        "//cda-database:cda_database",
        "//cda-interfaces:cda_interfaces",
        "//cda-sovd-interfaces:sovd_interfaces",
    ],
)
