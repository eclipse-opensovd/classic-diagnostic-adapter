load("@cda_crates//:defs.bzl", "crate_deps")
load("//bazel:rust_crate.bzl", "workspace_rust_library")

workspace_rust_library(
    name = "cda_pager",
    srcs = glob(["src/**/*.rs"]),
    crate_deps = [
        "parking_lot",
        "schemars",
        "serde",
        "thiserror",
        "tracing",
    ],
    crate_name = "cda_pager",
    crate_root = "src/lib.rs",
    deps = select({
        "@platforms//os:linux": crate_deps([
            "libc",
            "nix",
            "userfaultfd",
            "userfaultfd-sys",
        ]),
        "//conditions:default": [],
    }),
)
