load("//bazel:rust_crate.bzl", "workspace_rust_proc_macro")

workspace_rust_proc_macro(
    name = "override_macros",
    srcs = glob(["src/**/*.rs"]),
    crate_deps = [
        "proc-macro2",
        "quote",
        "syn",
    ],
    crate_name = "override_macros",
    crate_root = "src/lib.rs",
)
