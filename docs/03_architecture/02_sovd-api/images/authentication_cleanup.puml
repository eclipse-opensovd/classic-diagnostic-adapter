@startuml
title Authentication -- SID 29 -- deAuthenticate on lock release / expiry, mode_expiration, ECU cleanup

participant "Lock Manager /\nECU Cleanup" as TRIGGER
participant "Diagnostic\nKernel" as DIAG
participant ECU

TRIGGER -> DIAG : lock released / expired,\nmode_expiration elapsed\nor ECU cleanup
activate DIAG

alt tracked state == authenticated
  DIAG -> ECU : 29 00 (deAuthenticate)
  alt positive response
    ECU -> DIAG : 69 00
  else negative response / timeout
    ECU -> DIAG : 7F 29 {NRC}
    DIAG -> DIAG : log warning
  end
  DIAG -> DIAG : tracked state = deAuthenticated
end

DIAG -> DIAG : continue cleanup\n(reset security access and session)
deactivate DIAG

@enduml
