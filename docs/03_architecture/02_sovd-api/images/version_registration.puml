@startuml
title Version Registrar

participant "Application\nStartup" as APP
participant "Version\nRegistrar" as VREG
participant "HTTP Server\n(Axum)" as HTTP

APP -> VREG : new(vendor_name, implementation_version,\ncommit, build_date)
APP -> VREG : register_version_info()
activate VREG

VREG -> VREG : determine base_uri\nand api_version

VREG -> HTTP : register GET /version-info
activate HTTP
HTTP -> VREG : registered
deactivate HTTP

VREG -> APP : registration complete
deactivate VREG

loop each optional version data endpoint
    APP -> VREG : register_data(path)
    activate VREG
    VREG -> HTTP : register GET at path
    activate HTTP
    HTTP -> VREG : registered
    deactivate HTTP
    VREG -> APP : registration complete
    deactivate VREG
end

== Runtime: Client requests version info ==

participant Client

Client -> HTTP : GET /version-info
activate HTTP
HTTP -> Client : HTTP 200 OK\n{ "sovd_info": [ { "version": "...",\n"base_uri": "...", "vendor_info": { ... } } ] }
deactivate HTTP

@enduml
