@startuml
title Binary Encoding Selection

participant Client
participant "HTTP Server\n(Axum)" as HTTP
participant "SOVD\nHandler" as HANDLER
participant "Diagnostic\nKernel" as DIAG
participant "UDS / DoIP / CAN" as COMM

Client -> HTTP: Request\n[?x-sovd2uds-binary-encoding=base64|hex]
HTTP -> HTTP: Attach configured default\n(server.binary_encoding)
HTTP -> HANDLER: Request
HANDLER -> HANDLER: Resolve encoding\n(query parameter, else configured default)
alt invalid encoding
    HANDLER --> Client: 400 Bad Request
else
    HANDLER -> DIAG: Parameters + encoding
    DIAG -> DIAG: Decode A_BYTEFIELD values\n(database defaults and coded constants: hex)
    DIAG -> COMM: UDS request
    COMM --> DIAG: UDS response
    DIAG --> HANDLER: Decoded response
    HANDLER -> HANDLER: Serialize A_BYTEFIELD values\nand schema (format, default) in encoding
    HANDLER --> Client: JSON response
end
@enduml
